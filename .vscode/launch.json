{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Flask: Run",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app", "wsgi",
                "run",
                "--debug",
                "--no-reload",
                "--no-debugger",
                "--host", "127.0.0.1",
                "--port", "8000"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Start",
            "type": "debugpy",
            "request": "launch",
            "program": "dreeve.py",
            "console": "integratedTerminal"
        }
    ]
}